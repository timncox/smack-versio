# Native tests for the Versio firmware — runs on the laptop, no hardware.
#
#   make -f firmware/Makefile.test
#
# Covers the clock adapter (M2) and its integration with the vendored engine.
# The engine's own suite lives upstream in ~/tim-os/smack (`make test`).

CC     ?= cc
CXX    ?= c++
CFLAGS  = -O2 -g -Wall -Wextra
BUILD   = firmware/build

.PHONY: test clean

test: $(BUILD)/test_clock_adapter $(BUILD)/test_versio_alloc $(BUILD)/test_settings \
      $(BUILD)/test_dj_filter $(BUILD)/test_param_format $(BUILD)/test_ring_stall
	./$(BUILD)/test_clock_adapter
	./$(BUILD)/test_versio_alloc
	./$(BUILD)/test_settings
	./$(BUILD)/test_dj_filter
	./$(BUILD)/test_param_format
	./$(BUILD)/test_ring_stall

$(BUILD)/test_clock_adapter: firmware/test/test_clock_adapter.c \
                             firmware/clock_adapter.c \
                             firmware/vendor/smack_core.c
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) $^ -o $@ -lm

# Links smack_core_versio.c — the same unit the firmware builds — so the
# calloc/free redirect is exercised for real, not simulated.
$(BUILD)/test_versio_alloc: firmware/test/test_versio_alloc.c \
                            firmware/versio_alloc.c \
                            firmware/smack_core_versio.c
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -I firmware $^ -o $@ -lm

# The DJ filter is header-only so it can be measured here rather than judged by
# ear on the module -- see the file header for what that buys.
$(BUILD)/test_dj_filter: firmware/test/test_dj_filter.c firmware/dj_filter.h
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) firmware/test/test_dj_filter.c -o $@ -lm

# Pins the parameter output format. The engine must format every readable
# param with integer conversions only -- see the file header for why a "%f"
# silently returns nothing on the hardware this ships to.
$(BUILD)/test_param_format: firmware/test/test_param_format.c \
                            firmware/vendor/smack_core.c
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) $^ -o $@ -lm

# Drives the vendored engine for minutes of simulated audio to catch the ring
# recorder stalling behind a long loop. Slow by nature -- it is playing ~5
# minutes of audio through the full render path -- so it runs last.
$(BUILD)/test_ring_stall: firmware/test/test_ring_stall.c \
                          firmware/vendor/smack_core.c
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) $^ -o $@ -lm

# settings.h is C++ (PersistentStorage compares via operator!=), but it pulls in
# no libDaisy headers, so the wear-limiting logic tests on the laptop.
$(BUILD)/test_settings: firmware/test/test_settings.cpp firmware/settings.h
	@mkdir -p $(BUILD)
	$(CXX) $(CFLAGS) firmware/test/test_settings.cpp -o $@

clean:
	rm -rf $(BUILD)
